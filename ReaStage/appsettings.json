{
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "targets": {
      "logfile": {
        "fileName": "${specialfolder:folder=ApplicationData}/ReaStage/logs/reastage_${shortdate}.log",
        "layout": "${longdate} [${level:uppercase=true:padding=-5}] [${threadid}] [${logger}] ${message}${onexception:inner=\r\n  ${exception:format=tostring}}",
        "type": "File"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Trace",
        "writeTo": "logfile"
      }
    ]
  }
}