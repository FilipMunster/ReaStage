<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ReaStage.ViewModels"
             xmlns:conv="using:ReaStage.Converters"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="ReaStage.Views.StageView"
             x:DataType="vm:StageViewModel"
             Background="Transparent">

    <UserControl.Resources>
        <conv:ProgressWidthConverter x:Key="ProgressWidth"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.songBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="BoxShadow" Value="0 3 12 0 #40000000"/>
        </Style>
        <Style Selector="Border.prevSong TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Opacity" Value="0.38"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="Border.nextSong TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="Border.currentSong">
            <Setter Property="Background" Value="#C8171924"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Margin" Value="0,16"/>
            <Setter Property="BoxShadow" Value="0 18 48 0 #8C000000"/>
        </Style>
        <Style Selector="Border.currentSong.playing">
            <Setter Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
            <Setter Property="BoxShadow" Value="0 0 42 2 #384ADE80, 0 18 48 0 #8C000000"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid RowDefinitions="*,Auto,*" Margin="48,24">

            <!-- Previous songs, closest to the current song at the bottom -->
            <ItemsControl Grid.Row="0" ItemsSource="{Binding PreviousSongs}" VerticalAlignment="Bottom">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Classes="songBox prevSong">
                            <TextBlock Text="{Binding}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Current song with progress fill -->
            <Border Grid.Row="1" x:Name="CurrentFrame"
                    Classes="currentSong"
                    Classes.playing="{Binding IsPlaying}">
                <Panel>
                    <Border HorizontalAlignment="Left" CornerRadius="19">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Offset="0" Color="#1A4ADE80"/>
                                <GradientStop Offset="1" Color="#454ADE80"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Width" Duration="0:0:0.2"/>
                            </Transitions>
                        </Border.Transitions>
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource ProgressWidth}">
                                <Binding ElementName="CurrentFrame" Path="Bounds.Width"/>
                                <Binding Path="Progress"/>
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                    <StackPanel Margin="28,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentSongName}"
                                   FontSize="58" FontWeight="Bold" Foreground="#FFFFFF"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PositionText}"
                                   FontSize="22" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Panel>
            </Border>

            <!-- Upcoming songs -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding NextSongs}" VerticalAlignment="Top">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Classes="songBox nextSong">
                            <TextBlock Text="{Binding}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- REAPER unreachable overlay -->
        <Border Background="#E60C0B10" IsVisible="{Binding !IsReaperReachable}">
            <Border CornerRadius="18"
                    Background="#1FFF5252"
                    BorderBrush="#59FF5252"
                    BorderThickness="1"
                    BoxShadow="0 18 48 0 #B3000000"
                    Padding="48,28"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="REAPER nedostupný"
                           FontSize="38" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
            </Border>
        </Border>
    </Panel>
</UserControl>
