<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ReaStage.ViewModels"
             xmlns:conv="using:ReaStage.Converters"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="ReaStage.Views.StageView"
             x:Name="StageRoot"
             x:DataType="vm:StageViewModel"
             Background="Transparent">

    <UserControl.Resources>
        <conv:ProgressWidthConverter x:Key="ProgressWidth"/>
        <conv:FontScaleConverter x:Key="FontScale"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.songBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="BoxShadow" Value="0 3 12 0 #40000000"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- Armed by the first of a two-click jump -->
        <Style Selector="Border.songBox.armed">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
        </Style>
        <Style Selector="Border.prevSong TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Opacity" Value="0.38"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="Border.nextSong TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="Border.currentSong">
            <Setter Property="Background" Value="#C8171924"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Margin" Value="0,16"/>
            <Setter Property="MinHeight" Value="210"/>
            <Setter Property="BoxShadow" Value="0 18 48 0 #8C000000"/>
        </Style>
        <Style Selector="TextBlock.timePrimary">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.timeSecondary">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <!-- Status bar: small dim caption, large bright value (readable from the stage) -->
        <Style Selector="TextBlock.statLabel">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="TextBlock.statValue">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <!-- Metronome: no transitions, the dots must land with the audio click -->
        <Style Selector="Ellipse.beatDot">
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="#3DFFFFFF"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>
        <Style Selector="Ellipse.beatDot.lit">
            <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Stroke" Value="Transparent"/>
        </Style>
        <Style Selector="Ellipse.beatDot.lit.downbeat">
            <Setter Property="Fill" Value="{StaticResource DownbeatBrush}"/>
        </Style>
        <Style Selector="Border.currentSong.playing">
            <Setter Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
            <Setter Property="BoxShadow" Value="0 0 42 2 #384ADE80, 0 18 48 0 #8C000000"/>
        </Style>

        <!-- Bottom transport bar: dim by default, highlights on hover -->
        <Style Selector="Button.transport">
            <Setter Property="Width" Value="84"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Opacity" Value="0.35"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.transport:pointerover">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.transport:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- Bottom margin reserves room for the status bar -->
        <Grid RowDefinitions="*,Auto,*" Margin="48,24,48,74">

            <!-- Previous songs, closest to the current song at the bottom -->
            <ItemsControl Grid.Row="0" ItemsSource="{Binding PreviousSongs}" VerticalAlignment="Bottom">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StageSongItem">
                        <Border Classes="songBox prevSong" Classes.armed="{Binding IsArmed}" Tapped="OnSongTapped">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="{Binding #StageRoot.((vm:StageViewModel)DataContext).FontScale, Converter={StaticResource FontScale}, ConverterParameter=22}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Current song with progress fill; tapping the card is Play/Pause -->
            <Border Grid.Row="1" x:Name="CurrentFrame"
                    Classes="currentSong"
                    Classes.playing="{Binding IsPlaying}"
                    Cursor="Hand"
                    Tapped="OnCurrentSongTapped">
                <Panel>
                    <Border HorizontalAlignment="Left" CornerRadius="19">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Offset="0" Color="#1A4ADE80"/>
                                <GradientStop Offset="1" Color="#454ADE80"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Width" Duration="0:0:0.2"/>
                            </Transitions>
                        </Border.Transitions>
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource ProgressWidth}">
                                <Binding ElementName="CurrentFrame" Path="Bounds.Width"/>
                                <Binding Path="Progress"/>
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                    <TextBlock Text="{Binding CurrentSongName}"
                               FontSize="{Binding FontScale, Converter={StaticResource FontScale}, ConverterParameter=58}"
                               FontWeight="Bold" Foreground="#FFFFFF"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="116,26"/>

                    <!-- Previous / next sit on the card edges; the rest of the card taps to Play/Pause -->
                    <Button Classes="transport" Content="⏮" Command="{Binding PreviousCommand}"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <Button Classes="transport" Content="⏭" Command="{Binding NextCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <!-- Elapsed (left) and remaining (right), mm:ss over bar.beat -->
                    <Grid ColumnDefinitions="*,*" VerticalAlignment="Bottom" Margin="28,0,28,16">
                        <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding ElapsedText}" Classes="timePrimary"
                                       FontSize="{Binding FontScale, Converter={StaticResource FontScale}, ConverterParameter=34}"/>
                            <TextBlock Text="{Binding ElapsedBeatsText}" Classes="timeSecondary"
                                       FontSize="{Binding FontScale, Converter={StaticResource FontScale}, ConverterParameter=22}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding RemainingText}" Classes="timePrimary" TextAlignment="Right"
                                       FontSize="{Binding FontScale, Converter={StaticResource FontScale}, ConverterParameter=24}"/>
                            <TextBlock Text="{Binding RemainingBeatsText}" Classes="timeSecondary" TextAlignment="Right"
                                       FontSize="{Binding FontScale, Converter={StaticResource FontScale}, ConverterParameter=16}"/>
                        </StackPanel>
                    </Grid>
                </Panel>
            </Border>

            <!-- Upcoming songs -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding NextSongs}" VerticalAlignment="Top">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StageSongItem">
                        <Border Classes="songBox nextSong" Classes.armed="{Binding IsArmed}" Tapped="OnSongTapped">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="{Binding #StageRoot.((vm:StageViewModel)DataContext).FontScale, Converter={StaticResource FontScale}, ConverterParameter=32}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Bottom status bar -->
        <Panel VerticalAlignment="Bottom" Margin="28,0,28,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="{Binding OrderText}" Classes="statValue"
                               FontSize="{Binding FontScale, Converter={StaticResource FontScale}, ConverterParameter=28}"/>
                    <TextBlock Text="{Binding BpmText}" Classes="statValue"
                               FontSize="{Binding FontScale, Converter={StaticResource FontScale}, ConverterParameter=28}"/>
                    <TextBlock Text="{Binding TimeSignatureText}" Classes="statValue"
                               FontSize="{Binding FontScale, Converter={StaticResource FontScale}, ConverterParameter=28}"/>
                </StackPanel>

                <!-- Visual metronome, left aligned so the dots keep their place
                     when the bar length changes -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding MetronomeDots}"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="26,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="11"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MetronomeDot">
                            <Ellipse Classes="beatDot"
                                     Classes.lit="{Binding IsLit}"
                                     Classes.downbeat="{Binding IsDownbeat}"
                                     Width="{Binding #StageRoot.((vm:StageViewModel)DataContext).FontScale, Converter={StaticResource FontScale}, ConverterParameter=15}"
                                     Height="{Binding #StageRoot.((vm:StageViewModel)DataContext).FontScale, Converter={StaticResource FontScale}, ConverterParameter=15}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="zbývá" Classes="statLabel"
                               FontSize="{Binding FontScale, Converter={StaticResource FontScale}, ConverterParameter=17}"/>
                    <TextBlock Text="{Binding RemainingPlaylistText}" Classes="statValue" Margin="0,0,14,0"
                               FontSize="{Binding FontScale, Converter={StaticResource FontScale}, ConverterParameter=34}"/>
                    <TextBlock Text="konec" Classes="statLabel"
                               FontSize="{Binding FontScale, Converter={StaticResource FontScale}, ConverterParameter=17}"/>
                    <TextBlock Text="{Binding EndEstimateText}" Classes="statValue"
                               FontSize="{Binding FontScale, Converter={StaticResource FontScale}, ConverterParameter=34}"/>
                </StackPanel>
            </Grid>
        </Panel>

        <!-- REAPER unreachable overlay -->
        <Border Background="#E60C0B10" IsVisible="{Binding !IsReaperReachable}">
            <Border CornerRadius="18"
                    Background="#1FFF5252"
                    BorderBrush="#59FF5252"
                    BorderThickness="1"
                    BoxShadow="0 18 48 0 #B3000000"
                    Padding="48,28"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="REAPER nedostupný"
                           FontSize="38" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
            </Border>
        </Border>
    </Panel>
</UserControl>
