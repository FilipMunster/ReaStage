<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ReaStage.ViewModels"
             xmlns:conv="using:ReaStage.Converters"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="ReaStage.Views.StageView"
             x:DataType="vm:StageViewModel"
             Background="#0D0D0D">

    <UserControl.Resources>
        <conv:ProgressWidthConverter x:Key="ProgressWidth"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.songBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Border.prevSong TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Opacity" Value="0.4"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="Border.nextSong TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="Border.currentSong">
            <Setter Property="BorderBrush" Value="#666666"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,12"/>
        </Style>
        <Style Selector="Border.currentSong.playing">
            <Setter Property="BorderBrush" Value="#4CAF50"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid RowDefinitions="*,Auto,*" Margin="32,16">

            <!-- Previous songs, closest to the current song at the bottom -->
            <ItemsControl Grid.Row="0" ItemsSource="{Binding PreviousSongs}" VerticalAlignment="Bottom">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Classes="songBox prevSong">
                            <TextBlock Text="{Binding}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Current song with progress fill -->
            <Border Grid.Row="1" x:Name="CurrentFrame"
                    Classes="currentSong"
                    Classes.playing="{Binding IsPlaying}">
                <Panel>
                    <Border HorizontalAlignment="Left" Background="#3A3A3A" CornerRadius="7">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource ProgressWidth}">
                                <Binding ElementName="CurrentFrame" Path="Bounds.Width"/>
                                <Binding Path="Progress"/>
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                    <StackPanel Margin="24,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentSongName}"
                                   FontSize="56" FontWeight="Bold" Foreground="#FFFFFF"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PositionText}"
                                   FontSize="22" Foreground="#EEEEEE" Opacity="0.6"
                                   TextAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Panel>
            </Border>

            <!-- Upcoming songs -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding NextSongs}" VerticalAlignment="Top">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Classes="songBox nextSong">
                            <TextBlock Text="{Binding}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- REAPER unreachable overlay -->
        <Border Background="#CC1A0000" IsVisible="{Binding !IsReaperReachable}">
            <TextBlock Text="REAPER nedostupný"
                       FontSize="40" FontWeight="Bold" Foreground="#FF5252"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Panel>
</UserControl>
