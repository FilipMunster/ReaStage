<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ReaStage.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="ReaStage.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="Transparent">

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="BoxShadow" Value="0 8 24 0 #59000000"/>
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="LetterSpacing" Value="1.5"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Width" Value="220"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <!-- Not focusable: a focused button fires Click on Space key-up, which would
             restart the capture right after the key was recorded -->
        <Style Selector="Button.keyCapture">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="72,20" MaxWidth="680" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
                <TextBlock Text="Nastavení" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF"/>
                <Button Content="Vrátit změny" Command="{Binding RevertChangesCommand}" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section" Text="KLÁVESY"/>
                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Classes="label" Text="Play / Pauza"/>
                        <Button Grid.Row="0" Grid.Column="1" Classes="keyCapture"
                                Content="{Binding PlayPauseKeyDisplay}"
                                Command="{Binding StartCaptureCommand}" CommandParameter="PlayPause"/>
                        <TextBlock Grid.Row="1" Classes="label" Text="Předchozí píseň"/>
                        <Button Grid.Row="1" Grid.Column="1" Classes="keyCapture"
                                Content="{Binding PreviousKeyDisplay}"
                                Command="{Binding StartCaptureCommand}" CommandParameter="Previous"/>
                        <TextBlock Grid.Row="2" Classes="label" Text="Další píseň"/>
                        <Button Grid.Row="2" Grid.Column="1" Classes="keyCapture"
                                Content="{Binding NextKeyDisplay}"
                                Command="{Binding StartCaptureCommand}" CommandParameter="Next"/>
                    </Grid>
                    <TextBlock Text="Klikni na tlačítko a stiskni klávesu; Esc zruší."
                               Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section" Text="ZOBRAZENÍ"/>
                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Classes="label" Text="Práh šipky zpět (s)"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PreviousThresholdSeconds}"/>
                        <TextBlock Grid.Row="1" Classes="label" Text="Velikost písma (%)"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <Slider Width="220" Minimum="50" Maximum="200"
                                    TickFrequency="10" IsSnapToTickEnabled="True"
                                    Value="{Binding FontScalePercent}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FontScalePercent, StringFormat={}{0:0} %}"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Classes="label" Text="Vizuální metronom"/>
                        <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding ShowMetronome}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section" Text="REAPER"/>
                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Classes="label" Text="Host"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ReaperHost}"/>
                        <TextBlock Grid.Row="1" Classes="label" Text="HTTP port"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ReaperHttpPort}"/>
                        <TextBlock Grid.Row="2" Classes="label" Text="OSC port"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ReaperOscPort}"/>
                        <TextBlock Grid.Row="3" Classes="label" Text="Aktualizace regionů (s)"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RegionsPollSeconds}"/>
                    </Grid>
                    <TextBlock Text="Změna hostu a portů se projeví až po restartu aplikace."
                               Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section" Text="WEBOVÉ OVLÁDÁNÍ"/>
                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Classes="label" Text="Povolit web"/>
                        <ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding WebEnabled}"/>
                        <TextBlock Grid.Row="1" Classes="label" Text="Port webu"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WebPort}"/>
                    </Grid>
                    <TextBlock Text="Změna se projeví až po restartu aplikace. Web běží bez hesla, jen pro LAN."
                               Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="4,10,0,0"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <TextBlock Text="{Binding VersionText, StringFormat='ReaStage {0}'}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="4,16,0,24"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
