<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ReaStage.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="ReaStage.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="Transparent">

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="BoxShadow" Value="0 8 24 0 #59000000"/>
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="LetterSpacing" Value="1.5"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Width" Value="220"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="72,20" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="Nastavení" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section" Text="KLÁVESY"/>
                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Classes="label" Text="Play / Pauza"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PlayPauseKey}"/>
                        <TextBlock Grid.Row="1" Classes="label" Text="Předchozí píseň"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PreviousKey}"/>
                        <TextBlock Grid.Row="2" Classes="label" Text="Další píseň"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NextKey}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section" Text="ZOBRAZENÍ"/>
                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Classes="label" Text="Předchozích písní"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PreviousSongsShown}"/>
                        <TextBlock Grid.Row="1" Classes="label" Text="Následujících písní"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NextSongsShown}"/>
                        <TextBlock Grid.Row="2" Classes="label" Text="Práh šipky zpět (s)"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PreviousThresholdSeconds}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section" Text="REAPER"/>
                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Classes="label" Text="Host"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ReaperHost}"/>
                        <TextBlock Grid.Row="1" Classes="label" Text="HTTP port"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ReaperHttpPort}"/>
                        <TextBlock Grid.Row="2" Classes="label" Text="OSC port"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ReaperOscPort}"/>
                        <TextBlock Grid.Row="3" Classes="label" Text="Aktualizace regionů (s)"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RegionsPollSeconds}"/>
                    </Grid>
                    <TextBlock Text="Změna hostu a portů se projeví až po restartu aplikace."
                               Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="4,10,0,0"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,20,0,24">
                <Button Content="Uložit" Command="{Binding SaveCommand}" FontSize="16" Padding="28,9"/>
                <Button Content="Zpět" Command="{Binding BackCommand}" FontSize="16" Padding="28,9"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
