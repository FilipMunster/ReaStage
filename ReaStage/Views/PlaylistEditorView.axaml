<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ReaStage.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="ReaStage.Views.PlaylistEditorView"
             x:DataType="vm:PlaylistEditorViewModel"
             x:Name="Root"
             Background="Transparent">

    <UserControl.Styles>
        <Style Selector="Border.column">
            <Setter Property="Background" Value="#B8151721"/>
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,14,8"/>
            <Setter Property="Width" Value="320"/>
            <Setter Property="BoxShadow" Value="0 12 32 0 #73000000"/>
        </Style>
        <Style Selector="Border.songItem">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style Selector="Border.songItem:pointerover">
            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
        </Style>
        <Style Selector="Border.songItem.deleted">
            <Setter Property="Background" Value="#08FFFFFF"/>
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
        <Style Selector="TextBlock.songName">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.songName.missing">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style Selector="TextBlock.songName.deleted">
            <Setter Property="TextDecorations" Value="Strikethrough"/>
        </Style>
        <Style Selector="TextBlock.songLength">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.small">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="24,16">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="56,0,0,20">
            <TextBlock Text="Editor playlistů" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
            <Button Content="Nový playlist" Command="{Binding CreatePlaylistCommand}" VerticalAlignment="Center"/>
            <Button Content="Obnovit z REAPERu" Command="{Binding RefreshRegionsCommand}" VerticalAlignment="Center"/>
            <Button Content="Zpět" Command="{Binding BackCommand}" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Columns}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlaylistEditorViewModel+PlaylistColumnViewModel">
                        <Border Classes="column" DragDrop.AllowDrop="True">
                            <Grid RowDefinitions="Auto,*">
                                <!-- Column header -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                    <TextBlock Grid.Column="0" Text="REAPER" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                               IsVisible="{Binding IsReadOnly}"/>
                                    <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                             FontSize="16" IsVisible="{Binding !IsReadOnly}"/>
                                    <Button Grid.Column="1" Classes="small" Content="Duplikovat" Margin="8,0,0,0"
                                            IsVisible="{Binding !IsReadOnly}"
                                            Command="{Binding #Root.((vm:PlaylistEditorViewModel)DataContext).DuplicatePlaylistCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- Active songs (drag & drop reorder) -->
                                        <ItemsControl ItemsSource="{Binding Songs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PlaylistEditorViewModel+SongItemViewModel">
                                                    <Border Classes="songItem" PointerPressed="Song_PointerPressed">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Classes="songName" Classes.missing="{Binding IsMissing}" Text="{Binding Name}"/>
                                                                <TextBlock Classes="songLength" Text="{Binding LengthText}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Classes="small" Content="✕" VerticalAlignment="Center"
                                                                    IsVisible="{Binding CanEdit}"
                                                                    Command="{Binding #Root.((vm:PlaylistEditorViewModel)DataContext).DeleteSongCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Deleted songs, visually separated at the end -->
                                        <StackPanel IsVisible="{Binding HasDeletedSongs}" Margin="0,12,0,0">
                                            <Separator Background="#26FFFFFF" Height="1" Margin="0,0,0,6"/>
                                            <TextBlock Text="Smazané" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="2,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding DeletedSongs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PlaylistEditorViewModel+SongItemViewModel">
                                                        <Border Classes="songItem deleted">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Classes="songName deleted" Classes.missing="{Binding IsMissing}" Text="{Binding Name}"/>
                                                                    <TextBlock Classes="songLength" Text="{Binding LengthText}"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Classes="small" Content="Vrátit" VerticalAlignment="Center"
                                                                        Command="{Binding #Root.((vm:PlaylistEditorViewModel)DataContext).RestoreSongCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
