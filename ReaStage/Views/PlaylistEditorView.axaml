<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ReaStage.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="ReaStage.Views.PlaylistEditorView"
             x:DataType="vm:PlaylistEditorViewModel"
             Background="#0D0D0D">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
        <TextBlock Text="Editor playlistů zatím není k dispozici" FontSize="24" Foreground="#888888"/>
        <Button Content="Zpět" Command="{Binding BackCommand}" FontSize="16" Padding="24,8" HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
