<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ReaStage.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="ReaStage.Views.PlaylistEditorView"
             x:DataType="vm:PlaylistEditorViewModel"
             x:Name="Root"
             Background="Transparent">

    <UserControl.Styles>
        <Style Selector="Border.column">
            <Setter Property="Background" Value="#B8151721"/>
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,14,8"/>
            <Setter Property="Width" Value="320"/>
            <Setter Property="BoxShadow" Value="0 12 32 0 #73000000"/>
        </Style>
        <!-- Round check button marking the active playlist -->
        <Style Selector="Button.selectPlaylist">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.selectPlaylist Path">
            <Setter Property="Stroke" Value="#59FFFFFF"/>
        </Style>
        <Style Selector="Button.selectPlaylist.active">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.selectPlaylist.active Path">
            <Setter Property="Stroke" Value="#0C0D13"/>
        </Style>

        <Style Selector="Border.songItem">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style Selector="Border.songItem:pointerover">
            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
        </Style>
        <Style Selector="Border.songItem.deleted">
            <Setter Property="Background" Value="#08FFFFFF"/>
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
        <Style Selector="Border.songItem.dragging">
            <Setter Property="Opacity" Value="0.35"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
            <Setter Property="Background" Value="#144ADE80"/>
        </Style>
        <Style Selector="TextBlock.songName">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.songName.missing">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style Selector="TextBlock.songName.deleted">
            <Setter Property="TextDecorations" Value="Strikethrough"/>
        </Style>
        <Style Selector="TextBlock.songLength">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.small">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>
    </UserControl.Styles>

    <Panel>
    <Grid RowDefinitions="Auto,*" Margin="24,16">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="56,0,0,20">
            <TextBlock Text="Playlisty" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
            <Button Content="Vrátit změny" Command="{Binding RevertChangesCommand}" VerticalAlignment="Center"/>
            <Button Content="Nový playlist" Command="{Binding CreatePlaylistCommand}" VerticalAlignment="Center"/>
            <Button Content="Obnovit z REAPERu" Command="{Binding RefreshRegionsCommand}" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Columns}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlaylistEditorViewModel+PlaylistColumnViewModel">
                        <Border Classes="column" DragDrop.AllowDrop="True">
                            <Grid RowDefinitions="Auto,*">
                                <!-- Column header -->
                                <Grid x:Name="ColumnHeader" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                                    <!-- Makes this playlist the one the stage view plays from -->
                                    <Button Grid.Column="0" Classes="selectPlaylist"
                                            Classes.active="{Binding IsActive}"
                                            ToolTip.Tip="Nastavit jako aktivní"
                                            Command="{Binding #Root.((vm:PlaylistEditorViewModel)DataContext).SelectPlaylistCommand}"
                                            CommandParameter="{Binding}">
                                        <Path Data="M3,8.5 L6.5,12 L13,4" Stretch="Uniform"
                                              StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"
                                              Width="15" Height="15"/>
                                    </Button>
                                    <TextBlock Grid.Column="1" Text="REAPER" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               IsVisible="{Binding IsReadOnly}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                             FontSize="16" Margin="8,0,0,0" IsVisible="{Binding !IsReadOnly}"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0"
                                                IsVisible="{Binding !IsReadOnly}">
                                        <Button Classes="small" Content="Duplikovat"
                                                Command="{Binding #Root.((vm:PlaylistEditorViewModel)DataContext).DuplicatePlaylistCommand}"
                                                CommandParameter="{Binding}"/>
                                        <Button Classes="small danger" Content="Smazat"
                                                Command="{Binding #Root.((vm:PlaylistEditorViewModel)DataContext).RequestDeletePlaylistCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- Active songs (drag & drop reorder) -->
                                        <ItemsControl ItemsSource="{Binding Songs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PlaylistEditorViewModel+SongItemViewModel">
                                                    <Border Classes="songItem" Classes.dragging="{Binding IsDragging}" PointerPressed="Song_PointerPressed">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Classes="songName" Classes.missing="{Binding IsMissing}" Text="{Binding Name}"/>
                                                                <TextBlock Classes="songLength" Text="{Binding LengthText}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Classes="small" Content="✕" VerticalAlignment="Center"
                                                                    IsVisible="{Binding CanEdit}"
                                                                    Command="{Binding #Root.((vm:PlaylistEditorViewModel)DataContext).DeleteSongCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Deleted songs, visually separated at the end -->
                                        <StackPanel x:Name="DeletedSection" IsVisible="{Binding HasDeletedSongs}" Margin="0,12,0,0">
                                            <Separator Background="#26FFFFFF" Height="1" Margin="0,0,0,6"/>
                                            <TextBlock Text="Smazané" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="2,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding DeletedSongs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PlaylistEditorViewModel+SongItemViewModel">
                                                        <Border Classes="songItem deleted">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Classes="songName deleted" Classes.missing="{Binding IsMissing}" Text="{Binding Name}"/>
                                                                    <TextBlock Classes="songLength" Text="{Binding LengthText}"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Classes="small" Content="Vrátit" VerticalAlignment="Center"
                                                                        Command="{Binding #Root.((vm:PlaylistEditorViewModel)DataContext).RestoreSongCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

    <!-- Delete confirmation bar -->
    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28"
            CornerRadius="16"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource SurfaceBorderBrush}"
            BorderThickness="1"
            BoxShadow="0 12 32 0 #8C000000"
            Padding="20,14"
            IsVisible="{Binding PendingDeleteColumn, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
            <TextBlock VerticalAlignment="Center" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}">
                <Run Text="Smazat playlist"/>
                <Run Text="{Binding PendingDeleteColumn.Name, FallbackValue=''}" FontWeight="Bold"/>
                <Run Text="? Tuto akci nelze vzít zpět."/>
            </TextBlock>
            <Button Classes="danger" Content="Smazat" Command="{Binding ConfirmDeletePlaylistCommand}" FontSize="16" Padding="24,8"/>
            <Button Content="Zrušit" Command="{Binding CancelDeletePlaylistCommand}" FontSize="16" Padding="24,8"/>
        </StackPanel>
    </Border>

    <!-- Floating ghost card following the cursor while dragging -->
    <Canvas x:Name="GhostLayer" IsHitTestVisible="False">
        <Border x:Name="DragGhost"
                IsVisible="False"
                CornerRadius="10"
                Background="#F0222838"
                BorderBrush="{StaticResource AccentDimBrush}"
                BorderThickness="1"
                BoxShadow="0 10 24 0 #B3000000"
                Padding="14,8">
            <TextBlock x:Name="DragGhostText" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15"/>
        </Border>
    </Canvas>
    </Panel>
</UserControl>
