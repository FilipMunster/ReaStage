<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ReaStage.ViewModels"
        xmlns:views="using:ReaStage.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="ReaStage.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ReaStage">

    <Window.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#12131C"/>
            <GradientStop Offset="0.55" Color="#0C0D13"/>
            <GradientStop Offset="1" Color="#141020"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Styles>
        <!-- Mouse-only affordances. Keeping them out of the focus chain means a
             transport key can never activate one instead of driving playback. -->
        <Style Selector="Button.menu, Button.hamburger">
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="Button.menu">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.menu:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
        </Style>
        <Style Selector="Button.hamburger">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </Window.Styles>

    <Panel>
        <SplitView IsPaneOpen="{Binding IsPaneOpen}"
                   DisplayMode="Overlay"
                   OpenPaneLength="300"
                   PaneBackground="Transparent">
            <SplitView.Pane>
                <!-- Floating menu card -->
                <Border Margin="10"
                        CornerRadius="18"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        BoxShadow="0 14 36 0 #A6000000"
                        Padding="12">
                    <StackPanel Margin="0,52,0,0" Spacing="4">
                        <Button Classes="menu" Content="Nastavení" Command="{Binding ShowSettingsCommand}"/>
                        <Button Classes="menu" Content="Editor playlistů" Command="{Binding ShowPlaylistEditorCommand}"/>
                        <Button Classes="menu" Content="Volba playlistu" Command="{Binding ShowPlaylistSelectionCommand}"/>
                    </StackPanel>
                </Border>
            </SplitView.Pane>

            <ContentControl Content="{Binding CurrentPage}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:StageViewModel">
                        <views:StageView/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:SettingsViewModel">
                        <views:SettingsView/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:PlaylistSelectionViewModel">
                        <views:PlaylistSelectionView/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:PlaylistEditorViewModel">
                        <views:PlaylistEditorView/>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </SplitView>

        <!-- Hamburger stays on top of everything in the top-left corner -->
        <Button Classes="hamburger"
                Content="☰"
                Command="{Binding TogglePaneCommand}"
                VerticalAlignment="Top" HorizontalAlignment="Left"
                Margin="16"/>
    </Panel>
</Window>
